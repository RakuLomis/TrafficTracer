{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffictracer.local/contracts/target-config.schema.json",
  "title": "TrafficTracer normalized target configuration preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_path", "sha256", "targets", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "config_path": { "type": "string", "minLength": 1, "pattern": "^/" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "domain",
        "url",
        "duration_seconds",
        "network",
        "run_label",
        "wait_load_timeout"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$"
        },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "network": { "enum": ["tcp", "udp", "all"] },
        "run_label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "wait_load_timeout": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  }
}
