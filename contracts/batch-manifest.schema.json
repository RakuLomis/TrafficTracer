{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffictracer.local/contracts/batch-manifest.schema.json",
  "title": "TrafficTracer serial capture batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "state", "stage", "created_at", "updated_at",
    "output_root", "config", "execution", "targets", "current_index", "children", "fail_fast",
    "cancel_requested", "resume"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "batch_id": { "$ref": "#/$defs/uuid" },
    "state": { "enum": ["created", "running", "completed", "failed", "cancelled", "interrupted"] },
    "stage": { "enum": ["queued", "capture", "quiescence", "analysis", "checkpoint", "finished"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "output_root": { "$ref": "#/$defs/absolutePath" },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["interfaces", "chrome_binary", "controller_endpoint", "controller_generated_config", "options"],
      "properties": {
        "interfaces": {
          "type": "object", "additionalProperties": false,
          "required": ["tun", "physical"],
          "properties": {
            "tun": { "type": "string", "minLength": 1 },
            "physical": { "type": "string", "minLength": 1 }
          }
        },
        "chrome_binary": { "$ref": "#/$defs/absolutePath" },
        "controller_endpoint": { "type": "string", "minLength": 1 },
        "controller_generated_config": {
          "oneOf": [{ "$ref": "#/$defs/absolutePath" }, { "type": "null" }]
        },
        "options": {
          "type": "object", "additionalProperties": false,
          "required": ["capture_packets", "collect_cdp", "collect_netlog", "analyze_after_capture", "headless"],
          "properties": {
            "capture_packets": { "type": "boolean" },
            "collect_cdp": { "type": "boolean" },
            "collect_netlog": { "type": "boolean" },
            "analyze_after_capture": { "const": true },
            "headless": { "type": "boolean" },
            "pcap_split_mode": { "enum": ["none", "unique_connections"] },
            "cache_mode": { "enum": ["cold", "warm"] }
          }
        }
      }
    },
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "current_index": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "children": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": { "$ref": "#/$defs/child" }
    },
    "fail_fast": { "type": "boolean" },
    "cancel_requested": { "type": "boolean" },
    "resume": { "$ref": "#/$defs/resume" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "absolutePath": { "type": "string", "minLength": 1, "pattern": "^/" },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "url", "domain", "duration_seconds", "network", "run_label", "wait_load_timeout"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "domain": { "type": "string", "minLength": 1, "maxLength": 253 },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "network": { "enum": ["tcp", "udp", "all"] },
        "run_label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "wait_load_timeout": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "page_type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
      }
    },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["target_index", "state", "session_id", "error"],
      "properties": {
        "target_index": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["pending", "running", "completed", "failed", "cancelled", "interrupted"] },
        "session_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "next_index", "resumed_at"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 0 },
        "next_index": { "type": "integer", "minimum": 0 },
        "resumed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      }
    }
  }
}
