{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffictracer.local/contracts/flow.schema.json",
  "title": "TrafficTracer Complete correlated flow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "flow_id",
    "protocol",
    "pre_flow",
    "post_flow",
    "shared",
    "match",
    "request_ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "$ref": "#/$defs/uuid" },
    "flow_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "resource_type": { "type": "string" },
    "relation": { "type": "string" },
    "protocol": { "enum": ["tcp", "udp"] },
    "pre_flow": { "$ref": "#/$defs/flowTuple" },
    "post_flow": {
      "oneOf": [
        { "$ref": "#/$defs/flowTuple" },
        { "type": "null" }
      ]
    },
    "shared": { "type": "boolean" },
    "match": { "$ref": "#/$defs/match" },
    "request_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "conn_id": { "type": "string" },
    "outer_conn_id": { "type": "string" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "ipAddress": {
      "type": "string",
      "oneOf": [
        { "format": "ipv4" },
        { "format": "ipv6" }
      ]
    },
    "flowTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "src_ip", "src_port", "dst_ip", "dst_port", "complete", "source", "shared"],
      "properties": {
        "network": { "enum": ["tcp", "udp"] },
        "src_ip": { "$ref": "#/$defs/ipAddress" },
        "src_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dst_ip": { "$ref": "#/$defs/ipAddress" },
        "dst_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dst_host": { "type": "string" },
        "complete": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["pre_proxy", "post_proxy"] },
        "shared": { "type": "boolean" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "candidate_count"],
      "properties": {
        "status": { "enum": ["matched", "unmatched", "ambiguous", "legacy"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      }
    }
  }
}
