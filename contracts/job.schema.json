{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffictracer.local/contracts/job.schema.json",
  "title": "TrafficTracer Complete Job",
  "description": "Versioned job specifications accepted by the TrafficTracer Complete worker.",
  "oneOf": [
    { "$ref": "#/$defs/captureJobSpec" },
    { "$ref": "#/$defs/analysisJobSpec" },
    { "$ref": "#/$defs/batchJobSpec" },
    { "$ref": "#/$defs/packetSplitGroupJobSpec" }
  ],
  "$defs": {
    "jobId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "oneOf": [
            { "pattern": "^unix:///[^\\s]+$" },
            { "pattern": "^https?://[^\\s]+$" }
          ]
        },
        "secret": { "type": "string" },
        "generated_config": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tun", "physical"],
      "properties": {
        "tun": { "type": "string", "minLength": 1 },
        "physical": { "type": "string", "minLength": 1 }
      }
    },
    "captureOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_packets": { "type": "boolean", "default": true },
        "collect_cdp": { "type": "boolean", "default": true },
        "collect_netlog": { "type": "boolean", "default": true },
        "analyze_after_capture": { "type": "boolean", "default": true },
        "headless": { "type": "boolean", "default": false },
        "pcap_split_mode": {
          "enum": ["none", "unique_connections"],
          "default": "unique_connections"
        },
        "cache_mode": {
          "enum": ["cold", "warm"],
          "default": "cold"
        },
        "proxy_protocol_mode": {
          "enum": ["strict_single", "observe"],
          "default": "observe"
        },
        "expected_proxy_protocol": {
          "type": "string", "pattern": "^[A-Za-z0-9_-]*$"
        },
        "proxy_selection_group": {
          "type": "string"
        }
      }
    },
    "orchestration": {
      "type": "object", "additionalProperties": false,
      "required": ["pipeline_id", "run_id", "run_ordinal", "profile_uid", "selection_group", "requested_node"],
      "properties": {
        "pipeline_id": { "": "#//jobId" }, "run_id": { "": "#//jobId" },
        "run_ordinal": { "type": "integer", "minimum": 1 },
        "profile_uid": { "type": "string", "minLength": 1, "maxLength": 256 },
        "selection_group": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requested_node": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "ad_policy", "desired_primary_seconds"],
      "properties": {
        "provider": { "const": "youtube" },
        "ad_policy": { "const": "click_visible_skip" },
        "desired_primary_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "applicationRetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_retries"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_retries": { "enum": [0, 1] }
      }
    },
    "analysisOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "split_pcaps": { "type": "boolean", "default": true },
        "pcap_split_mode": {
          "enum": ["none", "unique_connections"],
          "default": "unique_connections"
        },
        "write_flow_index": { "type": "boolean", "default": true },
        "overwrite": { "type": "boolean", "default": false }
      }
    },
    "captureJobSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "job_id",
        "url",
        "domain",
        "duration_seconds",
        "network",
        "interfaces",
        "output_root",
        "chrome_binary",
        "controller"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "kind": { "const": "capture" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$"
        },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "network": { "enum": ["tcp", "udp", "all"] },
        "interfaces": { "$ref": "#/$defs/interfaces" },
        "output_root": { "$ref": "#/$defs/absolutePath" },
        "chrome_binary": { "$ref": "#/$defs/absolutePath" },
        "controller": { "$ref": "#/$defs/controller" },
        "options": { "$ref": "#/$defs/captureOptions" },
        "playback": { "$ref": "#/$defs/playback" },
        "wait_load_timeout": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "run_label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "target_source": { "$ref": "#/$defs/targetSource" },
        "page_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "orchestration": { "$ref": "#/$defs/orchestration" },
        "capture_group": {
          "type": "string",
          "pattern": "^(?:[0-9]{8}-[0-9]{6}-[0-9]{3})?$"
        }
      }
    },
    "analysisJobSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "session_dir", "output_root"],
      "properties": {
        "schema_version": { "const": 3 },
        "kind": { "const": "analysis" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "session_dir": { "$ref": "#/$defs/absolutePath" },
        "output_root": { "$ref": "#/$defs/absolutePath" },
        "options": { "$ref": "#/$defs/analysisOptions" }
      }
    },
    "batchTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "url", "domain", "duration_seconds", "network", "run_label", "wait_load_timeout"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "domain": { "type": "string", "minLength": 1, "maxLength": 253 },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "network": { "enum": ["tcp", "udp", "all"] },
        "run_label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "wait_load_timeout": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "playback": { "$ref": "#/$defs/playback" },
        "page_type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
      }
    },
    "batchJobSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "job_id", "config_path", "config_sha256",
        "targets", "interfaces", "output_root", "chrome_binary", "controller",
        "options", "fail_fast", "application_retry"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "kind": { "const": "batch" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "config_path": { "$ref": "#/$defs/absolutePath" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "targets": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "uniqueItems": true, "items": { "$ref": "#/$defs/batchTarget" }
        },
        "interfaces": { "$ref": "#/$defs/interfaces" },
        "output_root": { "$ref": "#/$defs/absolutePath" },
        "chrome_binary": { "$ref": "#/$defs/absolutePath" },
        "controller": { "$ref": "#/$defs/controller" },
        "options": { "$ref": "#/$defs/captureOptions" },
        "fail_fast": { "type": "boolean" },
        "application_retry": { "$ref": "#/$defs/applicationRetry" },
        "orchestration": { "$ref": "#/$defs/orchestration" }
      }
    },
    "packetSplitGroupJobSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "scope_id", "output_root", "policy"],
      "properties": {
        "schema_version": { "const": 3 },
        "kind": { "const": "packet_split_group" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "scope_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9]{3}$" },
        "output_root": { "$ref": "#/$defs/absolutePath" },
        "policy": { "enum": ["missing_only", "repair_incomplete"] }
      }
    },
    "targetSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "manual" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "config_path", "config_sha256", "target_index"],
          "properties": {
            "mode": { "const": "config" },
            "config_path": { "$ref": "#/$defs/absolutePath" },
            "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target_index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
